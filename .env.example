# Firebase Configuration (Service Account credentials)
FIREBASE_PROJECT_ID=equitraccion-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@equitraccion-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# Admin Credentials (Change these!)
ADMIN_EMAIL=admin@equitraccion.com
ADMIN_PASSWORD=change_this_password_in_production

# Site Configuration
SITE_URL=https://equitraccion.com
NODE_ENV=production

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Security
SESSION_SECRET=your_session_secret_here_minimum_32_characters
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Google Analytics (opcional)
GA_TRACKING_ID=G-XXXXXXXXXX

# Newsletter Configuration
NEWSLETTER_CRON_TOKEN=your_newsletter_cron_token_here
